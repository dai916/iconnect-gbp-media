Allow: /

User-agent: Claude-User
Allow: /

User-agent: OAI-SearchBot
Allow: /

User-agent: ChatGPT-User
Allow: /

User-agent: PerplexityBot
Allow: /

User-agent: Perplexity-User
Allow: /

User-agent: Google-Extended
Allow: /

User-agent: Bingbot
Allow: /

# --- 学習専用クローラー（拒否しても検索・引用には影響しない。院の方針で決める） ---
# User-agent: ClaudeBot
# Disallow: /
# User-agent: GPTBot
# Disallow: /
# User-agent: CCBot
# Disallow: /

# --- それ以外 ---
User-agent: *
Allow: /
Disallow: /wp-admin/
